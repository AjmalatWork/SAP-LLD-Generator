POSTGRES_USER=lld
POSTGRES_PASSWORD=lld
POSTGRES_DB=sap_lld
POSTGRES_PORT=5432

# Connection string used by the Python side (psycopg).
# Must match POSTGRES_PORT above if you override it (e.g. because 5432 is
# already in use by another local Postgres instance).
LLD_DATABASE_URL=postgresql://lld:lld@localhost:5432/sap_lld

# Embedding model: any local sentence-transformers model name.
# NOTE: if you change this to a model with a different output dimension than
# 384, update the `vector(384)` column definition in sql/init.sql to match,
# and re-create the Postgres volume/table.
LLD_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Fallback fixed-size chunking window, in lines, used when no method/routine
# boundaries are detected in an object's source.
LLD_CHUNK_SIZE_LINES=100
